# Copy to .env and set a local password before starting Docker Compose.
# Compose reads .env automatically. Python reads the process environment;
# use uv run --env-file .env to load this file explicitly. Keep .env out of Git.
POSTGRES_DB=rag_workflow_lab
POSTGRES_USER=rag_lab
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Python connection settings for the host-side application.
POSTGRES_HOST=127.0.0.1
POSTGRES_CONNECT_TIMEOUT=5

# Reserved for later URL-based clients, sandbox tools and tracing; not read yet.
# RETRIEVAL_DATABASE_URL=
# SANDBOX_DATABASE_URL=
# MLFLOW_TRACKING_URI=
